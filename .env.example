# Salesforce Executor local adapter environment.
# Keep real values in .env.local or Executor secrets; do not commit them.

# Default Salesforce org alias for setup scripts. Either SF_TARGET_ORG or
# D360_ORG_ALIAS must be set before running setup:salesforce; there is no
# baked-in default org so each developer points at their own.
SF_TARGET_ORG=
D360_ORG_ALIAS=

# Optional Salesforce DX MCP org set. Leave as DEFAULT_TARGET_ORG to honor
# the Salesforce CLI's default-target-org config.
SF_ORGS=DEFAULT_TARGET_ORG

# Path tokens substituted into the source registry at setup time.
# SALESFORCE_EXECUTOR_ROOT defaults to this checkout; override only when a
# different working tree should own the local launchers.
SALESFORCE_EXECUTOR_ROOT=

# Local clone of the Data 360 Codex plugin (contains scripts/run-data360-mcp.sh).
# When unset, setup:salesforce skips the data360-mcp source instead of
# spawning a launcher that cannot find its plugin.
D360_CODEX_PLUGIN_ROOT=

# Local clone of the Data 360 MCP server repo and built jar. doctor:salesforce
# reads these to surface the build hint without baking in absolute paths.
D360_MCP_REPO=
D360_MCP_JAR=

# Local Data 360 skill pack root (consumed by examples/data360-demo and
# benchmarks/d360 to load SKILL.md files for drift checks).
D360_SKILLS_DIR=
D360_CODEX_SKILLS_DIR=

# Informatica local API adapter.
INFORMATICA_BASE_URL=https://dm-us.informaticacloud.com
INFORMATICA_SESSION_ID=
INFORMATICA_BEARER_TOKEN=

# Executor runtime URL used by scripts. Defaults to the local Salesforce
# Executor port (`bun run dev:salesforce` listens on 4788).
EXECUTOR_URL=http://localhost:4788
